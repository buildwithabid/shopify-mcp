SHOPIFY_STORE_URL=https://your-store.myshopify.com

# Option A: Static token (legacy apps created before Jan 2026)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B: Client credentials (apps created after Jan 2026 via dev.shopify.com)
# Tokens auto-refresh every 24h — no manual rotation needed
# SHOPIFY_CLIENT_ID=your_client_id
# SHOPIFY_CLIENT_SECRET=your_client_secret

PORT=3000
